class Solution {
    public int check(int[] arr, int m, int k, int days) {
        int cons_flowers = 0, boq = 0;
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] <= days)
                cons_flowers++;
            else
                cons_flowers = 0;
            if (cons_flowers == k) {
                boq++;
                cons_flowers = 0;
            }
        }
        if (boq >= m)
            return 1;
        else 
            return 0;
    }

    public int minDays(int[] bloomDay, int m, int k) {
        int n = bloomDay.length;
        if ((long) m * k > n)
            return -1;

        int min = bloomDay[0], max = bloomDay[0];
        for (int i = 1; i < n; i++) {
            if (bloomDay[i] < min)
                min = bloomDay[i];
            if (bloomDay[i] > max)
                max = bloomDay[i];
        }

        int ans = max;
        while (min <= max) {
            int mid = min + (max - min) / 2;
            int res = check(bloomDay, m, k, mid);
            if (res == 1) {
                ans = mid;
                max = mid - 1; 
            } else {
                min = mid + 1; 
            }
        }
        return ans;
    }
}
