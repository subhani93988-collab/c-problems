class Solution {
    public int[] kthSmallestPrimeFraction(int[] arr, int k) {
         int n=arr.length;
         double[] arr1=new double[n*(n-1)/2];
         int h=0;
         for(int i=0;i<n-1;i++){
            for(int j=i+1;j<n;j++){
                arr1[h]=(double)arr[i]/arr[j];
                h++;
            }
         }
         Arrays.sort(arr1);
         double target=arr1[k-1];
         int[] arr2=new int[2];
         for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if((double)arr[i]/arr[j]==target){
                    arr2[0]=arr[i];
                    arr2[1]=arr[j];
                }
            }
         }
         return arr2;
    }
}
